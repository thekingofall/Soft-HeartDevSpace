# Include inside the existing nginx http block. Replace example domains and certificate paths.
server {
    listen 127.0.0.1:17678;
    server_name localhost;
    access_log off;
    location / {
        proxy_pass https://cf-dev.example.com;
        proxy_ssl_server_name on;
        proxy_ssl_name cf-dev.example.com;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/pki/tls/certs/ca-bundle.crt;
        proxy_set_header Host cf-dev.example.com;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_next_upstream off;
    }
}
server {
    listen 443 ssl;
    server_name dev.example.com;
    ssl_certificate /etc/letsencrypt/live/heartdevspace/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/heartdevspace/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 32m;
    client_body_timeout 300s;
    send_timeout 300s;
    include /etc/soft-heartdevspace/active-route.conf;
    add_header X-Heart-Transport $heart_transport always;
    add_header Cache-Control "no-store" always;
    location = /_heart/frp-health {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:17677/healthz;
        proxy_set_header Host dev.example.com;
        proxy_set_header Authorization "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
    location / {
        proxy_pass $heart_backend;
        proxy_http_version 1.1;
        proxy_set_header Host dev.example.com;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Never replay MCP writes after an uncertain response.
        proxy_next_upstream off;
    }
}
